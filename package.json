{
  "name": "splits-pact",
  "version": "0.1.0",
  "description": "Raise small onchain rounds by selling a slice of a 0xSplits Liquid Split along a bonding curve.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:contracts": "forge build --root contracts && node scripts/export-contracts.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "test:contracts": "forge test --root contracts",
    "deploy:factory": "forge script contracts/script/Deploy.s.sol:Deploy --root contracts --rpc-url https://mainnet.base.org --broadcast --verify",
    "test:e2e": "vite build && playwright test"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.54.0"
  },
  "overrides": {
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "forge-std": "github:foundry-rs/forge-std#v1.14.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.0"
  }
}
